# ---> R
# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Configuración para Docker (--env-file). Contiene las mismas credenciales que
# el .Renviron, sin comillas. La plantilla versionada es .env.example.
.env

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

#Artefactos html
*_files/*
*.html

# Base de datos de ejemplo
*.db

# Artefactos generados por r/validar_contrato.R. Este proyecto es un template:
# las pruebas, el runner y los resultados son salida ilustrativa del proceso, no
# código fuente, y se regeneran a partir del contrato.
tests/
run_tests.R
resultados_pruebas/

*.parquet
*.csv
