# Plantilla de configuración para ejecutar con Docker.
#
# Copia este archivo a .env y rellena los valores. NO uses comillas: a
# diferencia del .Renviron de R, el --env-file de Docker no las interpreta y las
# pasaría como parte del valor (CONTRACT_FILE_PATH="a.md" llegaría literalmente
# con las comillas y la ruta no existiría).
#
# .env está en .gitignore y en .dockerignore: nunca se versiona ni entra a la
# imagen.

# --- Servidor del LLM (compatible con la API de OpenAI) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=tu_api_key
LLM_MODEL=nombre_del_modelo
# Opcional: false si el proveedor no soporta streaming (por defecto true)
#LLM_STREAM=true

# --- Rutas del generador, relativas a la raíz del proyecto ---
CONTRACT_FILE_PATH=contrato/contrato_datos_minilibreria.md
SYSTEM_PROMPT_PATH=prompts/system_prompt.md
TEST_OUTPUT_DIR=tests

# --- Base de datos ---
# El generador no se conecta a la base de datos: solo usa estos valores para
# escribir el helpers.R correcto. Las credenciales las necesita run_tests.R.
DB_TYPE=sqlite
BASE_DE_DATOS=libreria.db
# Para postgres o sql_server, además:
#SERVIDOR=direccion_del_servidor
#USUARIO_DB=tu_usuario
#CONTRASENA_DB=tu_contrasena
#PUERTO_DB=5432

# --- Solo para run_tests.R, no para el generador ---
TEST_RESULTS_DIR=/home/datos_pruebas
